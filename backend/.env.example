# Copy to backend/.env (never commit .env).
# LLM text/photo signals (optional). Either key works; without both the rule text is used.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Force a provider when both keys are set: anthropic | gemini
# CONVERGE_LLM_PROVIDER=
# Set to "off" to disable the LLM even when a key is present.
CONVERGE_LLM=on
# Comma-separated frontend origins allowed by CORS.
CONVERGE_CORS_ORIGINS=http://localhost:3000
# Optional origin regex, e.g. https://.*\.vercel\.app
# CONVERGE_CORS_ORIGIN_REGEX=
# Database (default SQLite ./converge.db). Postgres URLs (postgres://...) also work.
# CONVERGE_DB_URL=sqlite:///./converge.db
