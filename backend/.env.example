# Copy to backend/.env (never commit .env).
# Enables claude-haiku-5-5 link explanations; without it the rule text is used.
ANTHROPIC_API_KEY=
# Set to "off" to disable the LLM even when a key is present.
CONVERGE_LLM=on
# Comma-separated frontend origins allowed by CORS.
CONVERGE_CORS_ORIGINS=http://localhost:3000
# SQLite location (default ./converge.db).
# CONVERGE_DB_URL=sqlite:///./converge.db
